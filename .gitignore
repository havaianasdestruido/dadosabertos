# Python
__pycache__/
*.pyc
.venv/
venv/

# Scratch output of a run (the committed examples are outputs/ and outputs-replica/,
# both reproducible with the tools/ scripts)
/outputs-replica-demo/
/tmp-outputs/
*.part
*.part.tmp
*.tmp

# The offline replica is generated (deterministically) by tests/make_replica.py —
# it is ~6 MB of synthetic payloads, so it is not versioned. Regenerate it with:
#     python3 tests/make_replica.py
tests/replica/

# Jupyter scratch. NOTE: the .ipynb files in notebooks/ are committed *with*
# their outputs (tables and rendered figures) on purpose — do not add a
# nbstripout filter or a "clear output" hook for them. Verify with:
#     python3 notebooks/run_notebooks.py --check
.ipynb_checkpoints/
